# Copy to .env (gitignored). NEVER put private keys or seed phrases in this repo.
# Optional: your own X Layer RPC for scripts and fork tests.
XLAYER_RPC=https://rpc.xlayer.tech

# Web app (web/.env.local). Leave unset until they exist — the UI then shows clearly labelled demo states.
VITE_CIRCUIT_ID=            # circuit id after tape-out on the OrderGuard processor
VITE_REGISTRY=              # FairSwitchRegistry address after deploy
VITE_REGISTRY_BLOCK=        # deploy block (speeds up event queries)
# VITE_PROCESSOR=0x57F319CF056F72F48cF1dbb670F2A3DB007Aa355   # default: OrderGuard public processor
